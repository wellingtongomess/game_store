      "get": {
        "summary": "Get total sales",
        "description": "Get total sales amount with optional period filter",
        "tags": ["Invoices"],
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
