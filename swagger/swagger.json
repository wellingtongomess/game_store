        ],
        "responses": {
          "200": {
            "description": "Total sales amount",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "number",
                      "format": "float",
                      "example": 1500.50
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
